@model PolicyClaimHub.Models.InsurancePolicy

@{
    ViewData["Title"] = "รายละเอียดกรมธรรม์";
}

<h1>รายละเอียดกรมธรรม์</h1>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.PolicyNumber)
            </dt>
            <dd class="col-sm-8">
                @Model.PolicyNumber
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.InsuredName)
            </dt>
            <dd class="col-sm-8">
                @Model.InsuredName
            </dd>

            <dt class="col-sm-4">ประเภทลูกค้า / โทรศัพท์</dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.CustomerType) · @Model.PhoneNumber
            </dd>

            <dt class="col-sm-4">ผลิตภัณฑ์</dt>
            <dd class="col-sm-8">@(Model.MotorProduct?.Name ?? "ไม่ระบุ")</dd>

            <dt class="col-sm-4">ข้อมูลรถ</dt>
            <dd class="col-sm-8">
                @Model.VehicleRegistration · @Model.VehicleMake @Model.VehicleModel (@Model.VehicleYear)
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.SumAssured)
            </dt>
            <dd class="col-sm-8">
                @Model.SumAssured.ToString("N2")
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.PremiumAmount)
            </dt>
            <dd class="col-sm-8">
                @Model.PremiumAmount.ToString("N2")
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.CoverageStartDate)
            </dt>
            <dd class="col-sm-8">
                @Model.CoverageStartDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.CoverageEndDate)
            </dt>
            <dd class="col-sm-8">
                @Model.CoverageEndDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Status)
            </dd>
        </dl>

        <hr />
        <h2 class="h5">ประวัติเคลม (@Model.ClaimHistories.Count ครั้ง)</h2>
        @if (Model.ClaimHistories.Count == 0)
        {
            <p class="text-success mb-0">ยังไม่มีประวัติเคลม</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>เลขเคลม</th><th>ประเภท</th><th>วันที่เกิดเหตุ</th><th class="text-end">ยอดจ่าย</th></tr></thead>
                    <tbody>
                    @foreach (var claim in Model.ClaimHistories.OrderByDescending(item => item.IncidentDate))
                    {
                        <tr>
                            <td>@claim.ClaimNumber</td>
                            <td>@Html.DisplayFor(_ => claim.ClaimType)</td>
                            <td>@claim.IncidentDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@claim.PaidAmount.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        แก้ไข
    </a>

    <a asp-action="Delete"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        ลบ
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        กลับหน้ารายการ
    </a>
</div>
