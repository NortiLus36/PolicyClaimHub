@model PolicyClaimHub.Models.InsurancePolicy

@{
    ViewData["Title"] = "ลบกรมธรรม์";
}

<h1>ลบกรมธรรม์</h1>

<div class="alert alert-danger">
    คุณต้องการลบกรมธรรม์นี้หรือไม่? การดำเนินการนี้ไม่สามารถย้อนกลับได้
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.PolicyNumber)
            </dt>
            <dd class="col-sm-8">
                @Model.PolicyNumber
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.InsuredName)
            </dt>
            <dd class="col-sm-8">
                @Model.InsuredName
            </dd>

            <dt class="col-sm-4">
                @Html.DisplayNameFor(model => model.Status)
            </dt>
            <dd class="col-sm-8">
                @Html.DisplayFor(model => model.Status)
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        ยืนยันการลบ
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        ยกเลิก
    </a>
</form>
