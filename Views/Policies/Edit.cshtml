@model PolicyClaimHub.Models.InsurancePolicy

@{
    ViewData["Title"] = "แก้ไขกรมธรรม์";
}

<h1>แก้ไขกรมธรรม์</h1>
<p class="text-muted">@Model.PolicyNumber — @Model.InsuredName</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_PolicyFormFields" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">บันทึกการแก้ไข</button>
        <a asp-action="Index" class="btn btn-secondary">ยกเลิก</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
