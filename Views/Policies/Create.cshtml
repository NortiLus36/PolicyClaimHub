@model PolicyClaimHub.Models.InsurancePolicy

@{
    ViewData["Title"] = "เพิ่มกรมธรรม์";
}

<h1>เพิ่มกรมธรรม์</h1>
<p class="text-muted">บันทึกข้อมูลลูกค้า รถยนต์ ผลิตภัณฑ์ และความคุ้มครองในหน้าเดียว</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_PolicyFormFields" model="Model" />

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">บันทึก</button>
        <a asp-action="Index" class="btn btn-secondary">กลับหน้ารายการ</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
