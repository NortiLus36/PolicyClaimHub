@model PolicyClaimHub.ViewModels.PortfolioDashboardViewModel

@{
    ViewData["Title"] = "วิเคราะห์ลูกค้าและการต่ออายุ";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="mb-1">วิเคราะห์ลูกค้าและการต่ออายุ</h1>
        <p class="text-muted mb-0">มุมมองสำหรับติดตามความเสี่ยง โอกาสต่ออายุ และเบี้ยแนะนำ</p>
    </div>
    <a asp-controller="Policies" asp-action="Create" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1" aria-hidden="true"></i>เพิ่มกรมธรรม์
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl">
        <div class="card h-100 shadow-sm"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon text-bg-primary"><i class="fa-solid fa-users"></i></span>
            <div><div class="text-muted small">ลูกค้าทั้งหมด</div><div class="fs-2 fw-semibold">@Model.TotalCustomers</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl">
        <div class="card h-100 shadow-sm"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon text-bg-info"><i class="fa-solid fa-user-plus"></i></span>
            <div><div class="text-muted small">ลูกค้าใหม่</div><div class="fs-2 fw-semibold">@Model.NewCustomers</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl">
        <div class="card h-100 shadow-sm"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon text-bg-success"><i class="fa-solid fa-rotate"></i></span>
            <div><div class="text-muted small">โอกาสต่ออายุสูง</div><div class="fs-2 fw-semibold">@Model.RenewalCandidates</div></div>
        </div></div>
    </div>
    <div class="col-6 col-xl">
        <div class="card h-100 shadow-sm"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon text-bg-danger"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <div><div class="text-muted small">ความเสี่ยงสูง</div><div class="fs-2 fw-semibold">@Model.HighRiskCustomers</div></div>
        </div></div>
    </div>
    <div class="col-12 col-xl">
        <div class="card h-100 shadow-sm"><div class="card-body d-flex gap-3 align-items-center">
            <span class="stat-icon text-bg-warning"><i class="fa-solid fa-coins"></i></span>
            <div><div class="text-muted small">เบี้ยรวม</div><div class="fs-4 fw-semibold">@Model.TotalPremium.ToString("N0") บาท</div></div>
        </div></div>
    </div>
</div>

<form id="portfolioFilterForm" method="get" class="filter-panel rounded-3 shadow-sm p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-lg-5">
            <label for="search" class="form-label small text-muted">ค้นหาลูกค้า</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input id="search" name="search" value="@ViewBag.Search" class="form-control"
                       placeholder="ชื่อ เลขกรมธรรม์ หรือทะเบียนรถ" />
            </div>
        </div>
        <div class="col-md-5 col-lg-3">
            <label for="risk" class="form-label small text-muted">ระดับความเสี่ยง</label>
            <select id="risk" name="risk" class="form-select" data-auto-fetch>
                <option value="">ทุกระดับความเสี่ยง</option>
                <option value="Low" selected="@(ViewBag.Risk == "Low")">ต่ำ</option>
                <option value="Standard" selected="@(ViewBag.Risk == "Standard")">มาตรฐาน</option>
                <option value="Watchlist" selected="@(ViewBag.Risk == "Watchlist")">เฝ้าระวัง</option>
                <option value="High" selected="@(ViewBag.Risk == "High")">สูง</option>
            </select>
        </div>
        <div class="col-md-3 col-lg-2">
            <label for="pageSize" class="form-label small text-muted">แสดงต่อหน้า</label>
            <select id="pageSize" name="pageSize" class="form-select" data-auto-fetch>
                <option value="10" selected="@(Model.PageSize == 10)">10 รายการ</option>
                <option value="20" selected="@(Model.PageSize == 20)">20 รายการ</option>
                <option value="50" selected="@(Model.PageSize == 50)">50 รายการ</option>
            </select>
        </div>
        <div class="col-md-4 col-lg-2 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">
                <i class="fa-solid fa-magnifying-glass me-1"></i>ค้นหา
            </button>
            <button id="clearPortfolioFilters" class="btn btn-outline-secondary" type="button" title="ล้างตัวกรอง">
                <i class="fa-solid fa-rotate-left"></i>
            </button>
        </div>
    </div>
</form>

<div id="portfolioResults" aria-live="polite">
    <partial name="_CustomerResults" model="Model" />
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("portfolioFilterForm");
            const results = document.getElementById("portfolioResults");

            async function fetchResults(page = 1) {
                const parameters = new URLSearchParams(new FormData(form));
                parameters.set("page", page);
                results.classList.add("opacity-50");

                try {
                    const response = await fetch(`${window.location.pathname}?${parameters}`, {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    results.innerHTML = await response.text();
                    history.replaceState(null, "", `${window.location.pathname}?${parameters}`);
                    bindPagination();
                } catch (error) {
                    console.error("โหลดข้อมูล Portfolio ไม่สำเร็จ", error);
                    results.innerHTML = '<div class="alert alert-danger">ไม่สามารถโหลดข้อมูลได้ กรุณาลองใหม่</div>';
                } finally {
                    results.classList.remove("opacity-50");
                }
            }

            function bindPagination() {
                results.querySelectorAll("[data-portfolio-page]").forEach(link => {
                    link.addEventListener("click", event => {
                        event.preventDefault();
                        fetchResults(link.dataset.portfolioPage);
                    });
                });
            }

            form.addEventListener("submit", event => {
                event.preventDefault();
                fetchResults(1);
            });
            form.querySelectorAll("[data-auto-fetch]").forEach(select =>
                select.addEventListener("change", () => fetchResults(1)));
            document.getElementById("clearPortfolioFilters").addEventListener("click", () => {
                form.reset();
                document.getElementById("search").value = "";
                document.getElementById("risk").value = "";
                fetchResults(1);
            });
            bindPagination();
        })();
    </script>
}
