@model PolicyClaimHub.ViewModels.PortfolioDashboardViewModel
@using PolicyClaimHub.Models
@using PolicyClaimHub.Services.Renewals

@{
    ViewData["Title"] = "วิเคราะห์ลูกค้าและการต่ออายุ";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">วิเคราะห์ลูกค้าและการต่ออายุ</h1>
        <p class="text-muted mb-0">ข้อมูลจำลองและกฎประเมินสำหรับ Portfolio ไม่ใช่เกณฑ์รับประกันภัยจริง</p>
    </div>
    <a asp-controller="Policies" asp-action="Create" class="btn btn-primary">เพิ่มกรมธรรม์</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted">ลูกค้าทั้งหมด</div><div class="fs-2 fw-semibold">@Model.TotalCustomers</div></div></div></div>
    <div class="col-6 col-xl"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted">ลูกค้าใหม่</div><div class="fs-2 fw-semibold text-primary">@Model.NewCustomers</div></div></div></div>
    <div class="col-6 col-xl"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted">โอกาสต่ออายุสูง</div><div class="fs-2 fw-semibold text-success">@Model.RenewalCandidates</div></div></div></div>
    <div class="col-6 col-xl"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted">ความเสี่ยงสูง</div><div class="fs-2 fw-semibold text-danger">@Model.HighRiskCustomers</div></div></div></div>
    <div class="col-12 col-xl"><div class="card h-100 shadow-sm"><div class="card-body"><div class="text-muted">เบี้ยรวม</div><div class="fs-4 fw-semibold">@Model.TotalPremium.ToString("N0") บาท</div></div></div></div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="ค้นหาชื่อ เลขกรมธรรม์ หรือทะเบียนรถ" />
    </div>
    <div class="col-md-3">
        <select name="risk" class="form-select">
            <option value="">ทุกระดับความเสี่ยง</option>
            <option value="Low" selected="@(ViewBag.Risk == "Low")">ต่ำ</option>
            <option value="Standard" selected="@(ViewBag.Risk == "Standard")">มาตรฐาน</option>
            <option value="Watchlist" selected="@(ViewBag.Risk == "Watchlist")">เฝ้าระวัง</option>
            <option value="High" selected="@(ViewBag.Risk == "High")">สูง</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-outline-primary flex-grow-1" type="submit">ค้นหา</button>
        <a asp-action="Index" class="btn btn-outline-secondary">ล้าง</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>ลูกค้า / กรมธรรม์</th>
                <th>ผลิตภัณฑ์ / รถ</th>
                <th class="text-end">เบี้ยปัจจุบัน</th>
                <th class="text-center">ประวัติเคลม</th>
                <th>ความเสี่ยง</th>
                <th class="text-center">โอกาสต่ออายุ</th>
                <th class="text-end">เบี้ยแนะนำ</th>
                <th>คำแนะนำ</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Customers)
        {
            var riskText = row.Assessment.RiskLevel switch
            {
                CustomerRiskLevel.Low => "ต่ำ",
                CustomerRiskLevel.Standard => "มาตรฐาน",
                CustomerRiskLevel.Watchlist => "เฝ้าระวัง",
                _ => "สูง"
            };
            var riskClass = row.Assessment.RiskLevel switch
            {
                CustomerRiskLevel.Low => "text-bg-success",
                CustomerRiskLevel.Standard => "text-bg-primary",
                CustomerRiskLevel.Watchlist => "text-bg-warning",
                _ => "text-bg-danger"
            };
            <tr>
                <td>
                    <a asp-controller="Policies" asp-action="Details" asp-route-id="@row.Policy.Id" class="fw-semibold text-decoration-none">@row.Policy.InsuredName</a>
                    <div class="small text-muted">@row.Policy.PolicyNumber · @Html.DisplayFor(_ => row.Policy.CustomerType)</div>
                </td>
                <td>
                    <div>@(row.Policy.MotorProduct?.Name ?? "ไม่ระบุผลิตภัณฑ์")</div>
                    <div class="small text-muted">@row.Policy.VehicleRegistration · @row.Policy.VehicleMake @row.Policy.VehicleModel</div>
                </td>
                <td class="text-end">@row.Policy.PremiumAmount.ToString("N0")</td>
                <td class="text-center">
                    <span class="badge text-bg-secondary">@row.Assessment.ClaimCount ครั้ง</span>
                    <div class="small text-muted">@row.Assessment.TotalClaimAmount.ToString("N0") บาท</div>
                </td>
                <td><span class="badge @riskClass">@riskText</span></td>
                <td class="text-center fw-semibold">@row.Assessment.RenewalProbabilityPercent%</td>
                <td class="text-end fw-semibold">@row.Assessment.RecommendedPremium.ToString("N0")</td>
                <td class="small" style="min-width: 220px">@row.Assessment.Recommendation</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Customers.Count == 0)
{
    <div class="alert alert-info">ไม่พบข้อมูลที่ตรงกับตัวกรอง</div>
}
