@{
    ViewData["Title"] = "Dashboard สินไหมน้ำท่วม";
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <style>
        #floodMap {
            min-height: 520px;
            border-radius: 0.5rem;
        }

        .claim-car-icon {
            color: #dc3545;
            font-size: 17px;
            line-height: 20px;
            text-align: center;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.95);
        }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="mb-1">Dashboard สินไหมน้ำท่วม</h1>
        <p class="text-muted mb-0">
            วิเคราะห์จุดสินไหมจำลองที่อยู่ภายใน Polygon คาดการณ์น้ำท่วมบริเวณเขตสาทร
        </p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <span id="floodPolygonStatus" class="badge text-bg-secondary">
            Polygon น้ำท่วม: กำลังตรวจสอบ
        </span>
        <button id="refreshDashboard" class="btn btn-outline-primary" type="button">
            รีเฟรชข้อมูล
        </button>
    </div>
</div>

<div class="small text-muted mb-3">
    Polygon จาก
    <a href="https://gistdaportal.gistda.or.th/data/rest/services/GFlood/GFlood_Inno_WMS/MapServer/2"
       target="_blank"
       rel="noopener noreferrer">GISTDA GFlood</a>
    เป็นผลวิเคราะห์/คาดการณ์ ไม่ใช่ขอบเขตที่ยืนยันจากการสำรวจภาคสนาม
</div>

<div id="dashboardError" class="alert alert-danger d-none" role="alert"></div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted">จำนวนเคลมในพื้นที่</div>
                <div id="claimCount" class="display-6 fw-semibold">-</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted">ยอดเรียกร้องรวม</div>
                <div id="totalRequested" class="fs-3 fw-semibold">-</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="text-muted">สินไหมประมาณการรวม</div>
                <div id="totalEstimated" class="fs-3 fw-semibold text-danger">-</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">
                แผนที่จำลองเหตุการณ์น้ำท่วมและจุดเคลมประกันภัยรถยนต์
            </div>
            <div class="card-body p-2">
                <div id="floodMap" aria-label="แผนที่สินไหมน้ำท่วมเขตสาทร"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div class="card shadow-sm h-100">
            <div class="card-header fw-semibold">สรุปภาระสินไหมแยกตามเขต</div>
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>เขต</th>
                            <th class="text-end">เคลม</th>
                            <th class="text-end">ประมาณการ</th>
                        </tr>
                    </thead>
                    <tbody id="districtSummaryBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script>
        const currencyFormatter = new Intl.NumberFormat("th-TH", {
            style: "currency",
            currency: "THB",
            maximumFractionDigits: 0
        });
        const sathornCenter = [13.720, 100.534];
        const map = L.map("floodMap").setView(sathornCenter, 15);

        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);
        map.attributionControl.addAttribution(
            '<a href="https://gistdaportal.gistda.or.th" target="_blank" rel="noopener noreferrer">GISTDA GFlood</a>');

        map.createPane("floodPolygonPane");
        map.getPane("floodPolygonPane").style.zIndex = 400;
        map.createPane("claimMarkerPane");
        map.getPane("claimMarkerPane").style.zIndex = 650;

        const floodPolygonLayer = L.geoJSON(null, {
            pane: "floodPolygonPane",
            style: {
                color: "#0066cc",
                weight: 2,
                fillColor: "#0dcaf0",
                fillOpacity: 0.42
            },
            onEachFeature: (feature, layer) => {
                const properties = feature.properties ?? {};
                const popup = document.createElement("div");
                const title = document.createElement("strong");
                title.textContent = "Polygon คาดการณ์น้ำท่วม";
                popup.appendChild(title);
                popup.appendChild(document.createElement("br"));
                popup.append(`รหัสพื้นที่: ${properties.sid ?? "ไม่ระบุ"}`);
                popup.appendChild(document.createElement("br"));
                popup.append(`ชั้นการคาดการณ์: ${properties.classify ?? "ไม่ระบุ"}`);
                popup.appendChild(document.createElement("br"));
                popup.append("แหล่งข้อมูล: GISTDA GFlood");
                layer.bindPopup(popup);
            }
        }).addTo(map);
        const claimMarkerLayer = L.layerGroup().addTo(map);
        const carIcon = L.divIcon({
            className: "claim-car-icon",
            html: '<i class="fa-solid fa-car-side" aria-hidden="true"></i>',
            iconSize: [20, 20],
            iconAnchor: [10, 10],
            popupAnchor: [0, -10]
        });

        function addCell(row, value, className = "") {
            const cell = document.createElement("td");
            cell.textContent = value;
            cell.className = className;
            row.appendChild(cell);
        }

        function setPolygonStatus(message, cssClass) {
            const status = document.getElementById("floodPolygonStatus");
            status.textContent = message;
            status.className = `badge ${cssClass}`;
        }

        async function loadFloodPolygon() {
            setPolygonStatus("Polygon น้ำท่วม: กำลังโหลด", "text-bg-secondary");
            const query = new URLSearchParams({
                where: "FID=14",
                outFields: "FID,sid,classify",
                returnGeometry: "true",
                outSR: "4326",
                f: "geojson"
            });
            const url =
                "https://gistdaportal.gistda.or.th/data/rest/services/GFlood/" +
                `GFlood_Inno_WMS/MapServer/2/query?${query}`;
            const controller = new AbortController();
            const timeoutId = window.setTimeout(() => controller.abort(), 15000);

            try {
                const response = await fetch(url, { signal: controller.signal });
                if (!response.ok) throw new Error(`GFlood API ตอบกลับ ${response.status}`);
                const data = await response.json();
                floodPolygonLayer.clearLayers();

                if (!Array.isArray(data.features) || data.features.length === 0) {
                    setPolygonStatus("Polygon น้ำท่วม: ไม่พบข้อมูล", "text-bg-info");
                    return;
                }

                floodPolygonLayer.addData(data);
                setPolygonStatus(
                    `Polygon น้ำท่วม: ${data.features.length.toLocaleString("th-TH")} พื้นที่`,
                    "text-bg-primary");
            } catch (error) {
                const message = error.name === "AbortError"
                    ? "Polygon น้ำท่วม: หมดเวลาการเชื่อมต่อ"
                    : "Polygon น้ำท่วม: เชื่อมต่อไม่ได้";
                setPolygonStatus(message, "text-bg-warning");
                console.error("โหลด Polygon น้ำท่วมไม่สำเร็จ", error);
            } finally {
                window.clearTimeout(timeoutId);
            }
        }

        async function loadDashboard() {
            const errorBox = document.getElementById("dashboardError");
            errorBox.classList.add("d-none");

            try {
                const [claimsResponse, summaryResponse] = await Promise.all([
                    fetch("/api/flood-claims"),
                    fetch("/api/flood-claims/summary")
                ]);
                if (!claimsResponse.ok || !summaryResponse.ok) {
                    throw new Error("API ไม่สามารถส่งข้อมูล Dashboard ได้");
                }

                const claims = await claimsResponse.json();
                const summary = await summaryResponse.json();
                const sathornClaims = claims.filter(claim => claim.district === "สาทร");
                const sathornSummary = summary.filter(item => item.district === "สาทร");
                const totalRequested = sathornSummary.reduce(
                    (total, item) => total + item.totalRequestedAmount, 0);
                const totalEstimated = sathornSummary.reduce(
                    (total, item) => total + item.totalEstimatedPayout, 0);

                document.getElementById("claimCount").textContent = sathornClaims.length;
                document.getElementById("totalRequested").textContent =
                    currencyFormatter.format(totalRequested);
                document.getElementById("totalEstimated").textContent =
                    currencyFormatter.format(totalEstimated);
                claimMarkerLayer.clearLayers();

                for (const claim of sathornClaims) {
                    const marker = L.marker([claim.latitude, claim.longitude], {
                        icon: carIcon,
                        pane: "claimMarkerPane",
                        title: claim.claimNumber
                    });
                    const popup = document.createElement("div");
                    const title = document.createElement("strong");
                    title.textContent = claim.claimNumber;
                    popup.appendChild(title);
                    popup.appendChild(document.createElement("br"));
                    popup.append(`เขต: ${claim.district}`);
                    popup.appendChild(document.createElement("br"));
                    popup.append(`ระดับน้ำ: ${claim.waterDepthCm} ซม.`);
                    popup.appendChild(document.createElement("br"));
                    popup.append(`ประมาณการ: ${currencyFormatter.format(claim.estimatedPayout)}`);
                    marker.bindPopup(popup);
                    claimMarkerLayer.addLayer(marker);
                }

                const tableBody = document.getElementById("districtSummaryBody");
                tableBody.replaceChildren();
                for (const item of sathornSummary) {
                    const row = document.createElement("tr");
                    addCell(row, item.district);
                    addCell(row, item.claimCount, "text-end");
                    addCell(row, currencyFormatter.format(item.totalEstimatedPayout), "text-end");
                    tableBody.appendChild(row);
                }
            } catch (error) {
                errorBox.textContent = error.message;
                errorBox.classList.remove("d-none");
            }
        }

        document.getElementById("refreshDashboard").addEventListener("click", () => {
            map.setView(sathornCenter, 15);
            loadFloodPolygon();
            loadDashboard();
        });

        loadFloodPolygon();
        loadDashboard();
    </script>
}
